# Local development only — do not use *.vercel.app for SEO tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (required on Vercel so canonicals/OG stay on the real domain)
# NEXT_PUBLIC_SITE_URL=https://www.solveek.com

# Supabase (publishable — safe for NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (SECRET — server / seed / CRM intake only, never NEXT_PUBLIC_*)
# SUPABASE_SERVICE_ROLE_KEY=

# CRM notes:
# 1. Invite users in Supabase Auth
# 2. Set crm_profiles.role to super_admin / admin / sales as needed
# 3. Sign in at /crm/login

# Google Analytics 4 Measurement ID (publishable)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console HTML-tag verification (optional, publishable)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_token

# Shared secret for future internal-only API routes (SECRET — fail closed if unset)
# INTERNAL_API_SECRET=

# Resend (SECRET — server only, never NEXT_PUBLIC_*)
# Create at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=hello@solveek.com
# Inbox that receives audit/contact/quote notifications
# LEAD_NOTIFY_EMAIL=you@example.com
