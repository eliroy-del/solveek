# Local development only — do not use *.vercel.app for SEO tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (required on Vercel so canonicals/OG stay on the real domain)
# NEXT_PUBLIC_SITE_URL=https://www.solveek.com

# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com/analytics/web/
# Format: G-XXXXXXXXXX — never commit a real ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console HTML-tag verification (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_token

# Shared secret for future internal-only API routes (fail closed if unset)
# INTERNAL_API_SECRET=generate-a-long-random-string
